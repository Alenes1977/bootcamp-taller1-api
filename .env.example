PORT=3000
DATABASE_PATH=./data/taller1.db  # guarda los dos talleres; el nombre viene del primero

# Secreto del webhook (Integrations → Webhooks en cada formulario Tally)
TALLY_WEBHOOK_SECRET=

# API key de Tally (Settings → API keys) para sincronización manual/recuperación
TALLY_API_KEY=

# IDs de los cuatro formularios Tally del Taller 1 (share tab o URL tally.so/r/XXXX)
TALLY_FORM_A_SIN=
TALLY_FORM_A_CON=
TALLY_FORM_B_SIN=
TALLY_FORM_B_CON=

# Taller 3: el formulario de veredictos de equipo, uno para las diez aulas
TALLY_FORM_T3_VEREDICTOS=yPO7qx

# IMPRESCINDIBLE ANTES DE CADA EDICIÓN DEL BOOTCAMP.
# Fecha ISO a partir de la cual cuentan los envíos. Borrar una respuesta en Tally
# NO borra lo que el webhook ya entregó, así que sin esto cada prueba de los días
# previos aparece el día del taller como un participante o un equipo más, con su
# puntuación. Se pone la hora de la primera mañana, en UTC (España va +2 en
# octubre: 06:00Z son las 08:00 de aquí). GET /health lo devuelve; si sale null,
# no está puesto.
RESULTADOS_DESDE=

# Protege POST /admin/sync, GET /admin/submissions y DELETE /admin/submissions/:id
ADMIN_API_KEY=

# Origen permitido para la app de conducción (ej. https://bootcamp.example.edu)
CORS_ORIGIN=*
